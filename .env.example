# Copy to .env and fill in. .env is git-ignored and never copied into the Docker image.
#
# Every agent can run without any credentials by setting the models to "stub:*",
# which is what the test suite does. Real keys are only needed for real answers.

# --- Credentials -------------------------------------------------------------
# Numbered suffixes are optional. Extra keys are used as automatic failover when
# a provider returns 429 / quota-exhausted.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

GOOGLE_API_KEY=
GOOGLE_API_KEY_2=

# --- Model routing -----------------------------------------------------------
# Format: "<provider>:<model>". Providers: groq | gemini | stub
COORDINATOR_MODEL=groq:llama-3.1-8b-instant
RESEARCHER_MODEL=gemini:gemini-3.5-flash
ANALYST_MODEL=groq:openai/gpt-oss-120b
WRITER_MODEL=groq:llama-3.3-70b-versatile

# Google Search grounding for the researcher. Off by default: it is not
# included in the Gemini free tier and returns 429 without a paid plan.
RESEARCHER_ENABLE_SEARCH=false

LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=2048

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0

# Absolute URL other agents should use to reach this one. Defaults to
# http://<host>:<port>/. Must be set when running behind Docker networking.
# PUBLIC_URL=http://coordinator:8000/

# Peers the coordinator discovers on startup, comma-separated base URLs.
PEER_AGENT_URLS=http://127.0.0.1:8001,http://127.0.0.1:8002,http://127.0.0.1:8003

DISCOVERY_RETRIES=10
DISCOVERY_RETRY_DELAY_SECONDS=1.5
PEER_REQUEST_TIMEOUT_SECONDS=180

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
